<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             x:Class="DigitalSignature.DigitalIDDialog">
    <ContentView.Resources>
        <Style x:Key="DialogContainerStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#F3EDF7"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Stroke" Value="#E5E5E5"/>
            <Setter Property="Padding" Value="24"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextColor" Value="#1F1F1F"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>

        <Style x:Key="EntryStyle" TargetType="Entry">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BackgroundColor" Value="#F3F3F3"/>
            <Setter Property="TextColor" Value="#1F1F1F"/>
            <Setter Property="PlaceholderColor" Value="#8A8886"/>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>

        <Style x:Key="TextInputLayoutStyle"
TargetType="inputLayout:SfTextInputLayout">

            <Setter Property="ContainerBackground"
     Value="#F8F8F8" />

            <Setter Property="Margin"
     Value="0,6,0,0" />

            <Setter Property="HeightRequest"
     Value="40" />

            <Setter Property="ShowHint"
     Value="True" />

            <Setter Property="IsHintAlwaysFloated"
     Value="False" />

            <Setter Property="ReserveSpaceForAssistiveLabels"
     Value="False" />

            <Setter Property="InputViewPadding">
                <Setter.Value>
                    <OnIdiom x:TypeArguments="Thickness">
                        <OnIdiom.Phone>
                            <OnPlatform x:TypeArguments="Thickness">
                                <On Platform="Android">16,10,0,0</On>
                                <On Platform="iOS">16,0,0,0</On>
                            </OnPlatform>
                        </OnIdiom.Phone>

                        <OnIdiom.Tablet>16,10,0,0</OnIdiom.Tablet>
                        <OnIdiom.Desktop>16,0,0,0</OnIdiom.Desktop>
                    </OnIdiom>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="BackgroundColor" Value="#6750A4"/>
            <Setter Property="TextColor" Value="#FFFFFF"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="BackgroundColor" Value="#EDEBE9"/>
            <Setter Property="TextColor" Value="#323130"/>
        </Style>
    </ContentView.Resources>
    <Grid>
        <Border x:Name="DesktopContainer"
            Grid.Row="0" Grid.Column="0"
            Style="{StaticResource DialogContainerStyle}"
            MaximumWidthRequest="500"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            IsVisible="True"                
            Padding="20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16"/>
            </Border.StrokeShape>

            <ScrollView>
                <VerticalStackLayout Spacing="0">
                    <!-- Title row with close button -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                        <Label Grid.Column="0"
                           Text="Sign with Digital ID"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#000000"
                           VerticalOptions="Center"/>

                        <Button Grid.Column="1"
                            x:Name="CloseDialogButton"
                            Text="&#xE70b;"
                            FontFamily="MauiMaterialAssets"
                            FontSize="20"
                            BackgroundColor="Transparent"
                            TextColor="#49454F"
                            BorderWidth="0"
                            WidthRequest="32"
                            HeightRequest="32"
                            Padding="0"
                            Clicked="OnCloseDialogClicked"/>
                    </Grid>

                    <!-- NEW: Info banner -->
                    <Border Padding="12"
                        Margin="0,0,0,16"
                        BackgroundColor="#EADDFF"
                        StrokeThickness="0"
                        HorizontalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="8"
                          HorizontalOptions="Fill">

                            <Label Grid.Column="0"
                               Text="&#9432;"
                               FontSize="14"
                               TextColor="#6750A4"
                               VerticalOptions="Start"
                               LineBreakMode="NoWrap"/>

                            <Label Grid.Column="1"
                               LineBreakMode="WordWrap"
                               HorizontalOptions="Fill"
                               HorizontalTextAlignment="Start"
                               VerticalOptions="Fill"
                               VerticalTextAlignment="Start">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Select a Digital ID to sign the document. If no Digital ID is selected, "
                                          FontSize="12"
                                          TextColor="#1D192B"/>
                                        <Span Text="the default Digital ID will be used automatically."
                                          FontSize="12"
                                          FontAttributes="Bold"
                                          TextColor="#1D192B"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>
                    </Border>

                    <!-- Certificate Section -->
                    <Label Text="Certificate File"
                       Style="{StaticResource LabelStyle}"
                       FontAttributes="Bold"/>

                    <Button x:Name="SelectCertificateButton"
                        Text="Select Certificate (.pfx)"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Clicked="OnSelectCertificateClicked"/>

                    <Label x:Name="CertificateFileName"
                       Text="No certificate selected"
                       FontSize="12"
                       TextColor="#666666"
                       Margin="0,8,0,0"/>

                    <!-- Password Section -->
                    <!-- Password -->
                    <Label Text="Certificate Password *"
                       Style="{StaticResource LabelStyle}"
                       FontAttributes="Bold"/>

                    <inputLayout:SfTextInputLayout
                            x:Name="passwordInputLayout"
                            Style="{StaticResource TextInputLayoutStyle}"
                            Hint="Enter password">

                        <Entry x:Name="PasswordEntry"
                           BackgroundColor="Transparent"
                           TextChanged="PasswordEntry_TextChanged"
                           IsPassword="True"
                           Placeholder="Enter password"
                           TextColor="#1F1F1F"
                           PlaceholderColor="#8A8886"
                           Focused="PasswordEntry_Focused"
                           Unfocused="PasswordEntry_Unfocused"
                           ClearButtonVisibility="Never"
                           VerticalTextAlignment="Center"/>
                    </inputLayout:SfTextInputLayout>
                    <Label x:Name="PasswordErrorLabel"
                       Text=""
                       FontSize="12"
                       TextColor="#B3261E"
                       Margin="0,4,0,0"
                       IsVisible="False"/>

                    <!-- Location -->
                    <Label Text="Location (Optional)"
                       Style="{StaticResource LabelStyle}"/>

                    <inputLayout:SfTextInputLayout
                            x:Name="locationInputLayout"
                            Style="{StaticResource TextInputLayoutStyle}"
                            Hint="e.g., Vancouver, BC, Canada">

                        <Entry x:Name="LocationEntry"
                           BackgroundColor="Transparent"
                           TextColor="#1F1F1F"
                           Placeholder="e.g., Vancouver, BC, Canada"
                           PlaceholderColor="#8A8886"
                           Focused="LocationEntry_Focused"
                           Unfocused="LocationEntry_Unfocused"
                           ClearButtonVisibility="Never"
                           VerticalTextAlignment="Center"/>
                    </inputLayout:SfTextInputLayout>

                    <!-- Reason -->
                    <Label Text="Reason (Optional)"
                       Style="{StaticResource LabelStyle}"/>

                    <inputLayout:SfTextInputLayout
                            x:Name="reasonInputLayout"
                            Style="{StaticResource TextInputLayoutStyle}"
                            Hint="e.g., Document approved">

                        <Entry x:Name="ReasonEntry"
                           BackgroundColor="#F3F3F3"
                           TextColor="#1F1F1F"
                           Placeholder="e.g., Document approved"
                           PlaceholderColor="#8A8886"
                           Focused="ReasonEntry_Focused"
                           Unfocused="ReasonEntry_Unfocused"
                           ClearButtonVisibility="Never"
                           VerticalTextAlignment="Center"/>
                    </inputLayout:SfTextInputLayout>

                    <!-- Contact Information -->
                    <Label Text="Contact Information (Optional)"
                       Style="{StaticResource LabelStyle}"/>

                    <inputLayout:SfTextInputLayout
                            x:Name="contactinfoInputLayout"
                            Style="{StaticResource TextInputLayoutStyle}"
                            Hint="e.g., john@company.com">

                        <Entry x:Name="ContactInfoEntry"
                           BackgroundColor="#F3F3F3"
                           TextColor="#1F1F1F"
                           PlaceholderColor="#8A8886"
                           Placeholder="e.g., john@company.com"
                           Focused="ContactInfoEntry_Focused"
                           Unfocused="ContactInfoEntry_Unfocused"
                           ClearButtonVisibility="Never"
                           VerticalTextAlignment="Center"/>
                    </inputLayout:SfTextInputLayout>

                    <!-- Buttons -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,24,0,0">
                        <Button Grid.Column="0"
                            Text="Cancel"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Clicked="OnCancelClicked"/>

                        <Button Grid.Column="1"
                            x:Name="ApplySignatureButtonDesktop"
                            Text="Apply Signature"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Clicked="OnApplySignatureClicked"/>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentView>
